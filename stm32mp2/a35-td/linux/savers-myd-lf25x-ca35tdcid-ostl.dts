/*
 * Copyright (C) Savers 2024 - All Rights Reserved
 *
 * Savers MYD-LF25X (Linux / CA35TDCID OSTL).
 *
 * Re-based onto MYiR's vanilla myb-stm32mp257x-1GB device tree (myb-base +
 * 1GB-resmem). MYiR's networking (myb-stm32mp257x-ethswitch.dtsi, dual
 * Motorcomm PHYs) is intentionally NOT included; the Savers carrier uses a
 * single TI DP83867 on eth1 instead (see &eth1 below).
 *
 * The reserved-memory carveouts come from MYiR's myb-stm32mp257x-1GB-resmem.dtsi
 * so they stay consistent with the rebased OP-TEE / U-Boot device trees.
 *
 * SoM: MYiR MYD-LF25X, STM32MP257F (AK package, kernel), 1GB LPDDR4.
 *
 * Board peripherals that were carried over from the original STM32MP257F-DK
 * copy (camera, Wi-Fi, USB hub, LEDs, ADC, USB-C, RTC, M33 examples) have been
 * dropped for a clean MYiR-based bring-up baseline; re-add them deliberately as
 * each is verified against the Savers schematic.
 */

/dts-v1/;

#include <dt-bindings/gpio/gpio.h>
#include <dt-bindings/net/ti-dp83867.h>
#include "myb-stm32mp257x-base.dtsi"
#include "myb-stm32mp257x-1GB-resmem.dtsi"
/* Carrier-board simple interfaces (I2C/USART/SPI/timers + GPIO names) from
 * STM32CubeMX (Savers.ioc). See the file header for scope/exclusions. */
#include "savers-myd-lf25x-ca35tdcid-ostl-mx.dtsi"

/ {
	model = "Savers MYD-LF25X (STM32MP257) CA35TDCID OSTL";
	compatible = "savers,savers-myd-lf25x", "st,myb-stm32mp257x-1GB",
		     "myir,myb-stm32mp257x-1GB", "myir,myd-lf25x", "st,stm32mp257";

	aliases {
		ethernet0 = &eth1;
		serial0 = &usart2;
	};

	chosen {
		stdout-path = "serial0:115200n8";
	};

	memory@80000000 {
		device_type = "memory";
		reg = <0x0 0x80000000 0x0 0x40000000>;
	};
};

/*
 * Savers Ethernet: single TI DP83867 on eth1 at MDIO address 0, using the
 * STM32MP257F-DK RGMII/MDIO pin group (eth1_rgmii_pins_b, which also carries
 * MDC/MDIO). The kernel SoC eth1 node is bare/disabled by default, so this
 * defines the MAC and MDIO bus from scratch.
 */
&eth1 {
	status = "okay";
	pinctrl-0 = <&eth1_rgmii_pins_b>;
	pinctrl-1 = <&eth1_rgmii_sleep_pins_b>;
	pinctrl-names = "default", "sleep";
	phy-mode = "rgmii-id";
	max-speed = <1000>;
	phy-handle = <&phy1_eth1>;
	st,eth-clk-sel;
	st,ext-phyclk = <&clk_ext_phy1>;
	snps,ext-systime;

	mdio1 {
		#address-cells = <1>;
		#size-cells = <0>;
		compatible = "snps,dwmac-mdio";

		/*
		 * Reset the DP83867 at the MDIO-bus level. __mdiobus_register()
		 * asserts/deasserts the bus "reset" GPIO BEFORE scanning the bus,
		 * so the PHY is awake when its ID is read. A reset-gpios in the
		 * PHY node would only be applied during phy_device registration,
		 * which for a generic "ti,dp83867" compatible happens AFTER the
		 * MDIO ID read in get_phy_device() -- too late, so the PHY is
		 * never seen and __stmmac_open() fails with -ENODEV.
		 * NB: the GPIO must live in only ONE node; a second gpiod request
		 * on PI4 from the PHY node would fail with -EBUSY.
		 */
		reset-gpios = <&gpioi 4 GPIO_ACTIVE_LOW>;	/* ETH1_PHY_RST (PI4) */
		reset-delay-us = <10000>;
		reset-post-delay-us = <80000>;

		phy1_eth1: ethernet-phy@0 {
			compatible = "ti,dp83867";
			reg = <0>;	/* DP83867 MDIO address strapped to 0 (confirmed: schematic + straps) */
			phy-mode = "rgmii-id";
			ti,rx-internal-delay = <DP83867_RGMIIDCTL_2_00_NS>;
			ti,tx-internal-delay = <DP83867_RGMIIDCTL_2_00_NS>;
			ti,fifo-depth = <DP83867_PHYCR_FIFO_DEPTH_4_B_NIB>;
		};
	};
};

/*
 * ---------------------------------------------------------------------------
 * Disable MYiR eval-board carrier peripherals inherited from
 * myb-stm32mp257x-base.dtsi. They sit on pins the Savers board reassigns
 * (CubeMX takes priority for GPIO/UART/SPI/...), so they are turned off here
 * to free those pins. The Savers carrier (WiFi/BT, USB-C mux, Ethernet)
 * follows the STM32MP257F-DK and is wired up separately.
 * ---------------------------------------------------------------------------
 */

/* Heartbeat LEDs (option C): keep led-green on PH4 (LED1) as a system-alive
 * blink; drop led-blue so PZ5 (SLED_LOADING) is free for the application. */
&{/gpio-leds} {
	/delete-node/ led-blue;
};

&{/gpio-keys} {
	status = "disabled";			/* MYiR eval button on PB15 */
};

&ov5640 {
	status = "disabled";			/* camera: PD0=STM_AX_SPI1_CS, PD2=STM_AX_EN2 */
};

&reg_cam_3V3 {
	status = "disabled";			/* camera 3V3 enable on PD1=SPI1_MISO */
};

&reg_bt_3V3 {
	status = "disabled";			/* MYiR BT 3V3 on PD7=LED_ILL; Savers BT = BT_REG_ON/PG4 */
};

&usdhc1_pwrseq {
	status = "disabled";			/* MYiR WiFi pwrseq reset on PD5=RGB1_G (DK wifi added later) */
};

&panel_lvds {
	status = "disabled";			/* MYiR LVDS panel (Savers uses an SPI display) */
};

&panel_dsi_backlight {
	status = "disabled";			/* backlight on PI5=SPI5_MOSI */
};

&panel_lvds_backlight {
	status = "disabled";			/* backlight on PH5=DISPLAY_DC */
};

&uart9 {
	status = "disabled";			/* MYiR extra UART; RTS on PI10=SLED_NEEDLING */
};

&i2c2 {
	stusb1600@28 {
		status = "disabled";		/* USB-C PD: reset PZ2=GP3, and no PD circuit on Savers */
	};
};

&i2c3 {
	/* MYiR's edt-ft5x06 touch is not compiled in (the gt911 variant is, and
	 * it's already disabled) -> PB0/SPI2_SCK is actually free. Only the lt9611
	 * HDMI bridge is active here. */
	hdmi-bridge@39 {
		status = "disabled";		/* lt9611 HDMI reset PI0=TAG_PRESENCE */
	};
};

/*
 * ---------------------------------------------------------------------------
 * WiFi / Bluetooth (Murata / Broadcom), wired like the STM32MP257F-DK — same
 * module and pins on the Savers board:
 *   WiFi   : SDMMC3 SDIO, WL_REG_ON = PG8 (wifi_pwrseq)
 *   BT     : USART1, BT_REG_ON = PG4 (shutdown-gpios)
 *   32 kHz : RTC LSCO on RTC_OUT2 (PI8) feeds the module's LPO
 * NOTE: the brcmfmac / Murata firmware blobs must be installed in the rootfs
 * (image recipe) for WiFi/BT to actually come up.
 * ---------------------------------------------------------------------------
 */
/ {
	wifi_pwrseq: wifi-pwrseq {
		compatible = "mmc-pwrseq-simple";
		reset-gpios = <&gpiog 8 GPIO_ACTIVE_LOW>;	/* WL_REG_ON (PG8) */
		clocks = <&rtc>;
		clock-names = "ext_clock";
	};
};

&rtc {
	#clock-cells = <0>;
	st,lsco = <RTC_OUT2_RMP>;			/* 32 kHz LPO out on RTC_OUT2 (PI8) */
	pinctrl-0 = <&rtc_out2_rmp_pins_a>;
	pinctrl-names = "default";
	status = "okay";
};

&sdmmc3 {
	/* Use the Savers/DK WL_REG_ON (PG8) pwrseq, not MYiR's disabled one (PD5). */
	mmc-pwrseq = <&wifi_pwrseq>;
	vmmc-supply = <&scmi_v3v3>;
	cap-sdio-irq;
	non-removable;
};

&usart1 {
	bluetooth {
		compatible = "brcm,bcm43438-bt";
		shutdown-gpios = <&gpiog 4 GPIO_ACTIVE_HIGH>;	/* BT_REG_ON (PG4) */
		clocks = <&rtc>;
		clock-names = "lpo";
		max-speed = <2000000>;
		vbat-supply = <&scmi_v3v3>;
		vddio-supply = <&scmi_v3v3>;
	};
};
