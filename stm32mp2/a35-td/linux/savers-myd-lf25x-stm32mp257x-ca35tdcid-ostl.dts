/dts-v1/;

#include <dt-bindings/gpio/gpio.h>
#include <dt-bindings/input/input.h>
#include <dt-bindings/leds/common.h>
#include <dt-bindings/rtc/rtc-stm32.h>
#include <dt-bindings/net/ti-dp83867.h>
#include "stm32mp257.dtsi"
#include "stm32mp25xf.dtsi"
#include "stm32mp25-pinctrl.dtsi"
#include "stm32mp25xxak-pinctrl.dtsi"
#include "savers-myd-lf25x-stm32mp257x-ca35tdcid-ostl-resmem.dtsi"
#include "savers-myd-lf25x-stm32mp257x-ca35tdcid-ostl-mx.dtsi"
 
/ {
	model = "Savers ATS Controller with MYiR MYD-LF25X";
	compatible = "st,savers-myd-lf25x", "savers,savers-myd-lf25x", "myir,myd-lf25x", "st,stm32mp257";

	aliases {
		ethernet1 = &eth1;
		serial0 = &usart2;
		serial1 = &usart1;
		serial3 = &usart3;
		serial6 = &usart6;
		i2c1 = &i2c1;
		i2c2 = &i2c2;
		i2c3 = &i2c3;
		i2c8 = &i2c8;
        mmc0 = &sdmmc1;
        mmc1 = &sdmmc2;
        mmc2 = &sdmmc3;
	};

	memory@80000000 {
		device_type = "memory";
		reg = <0x0 0x80000000 0x0 0x40000000>;
	};

	chosen {
		stdout-path = "serial0:115200n8";
	};

	gpio-leds {
		compatible = "gpio-leds";

		led-green {
			function = LED_FUNCTION_HEARTBEAT;
			color = <LED_COLOR_ID_GREEN>;
			gpios = <&gpioh 4 GPIO_ACTIVE_LOW>;
			linux,default-trigger = "heartbeat";
			default-state = "off";
		};
	};

};

&i2s1 {
	status = "disabled";
};

&a35ss_syscfg {
	status = "okay";
};

&ahbsr {
	mbox_client: mailbox-client@1 {
		compatible = "mbox-cdev";
		reg = <1 0>;
		memory-region =  <&ipc_shmem_2>;
		mboxes = <&ipcc2 0>;
		mbox-names = "rx-tx";
		status = "okay";
	};
};

&arm_wdt {
	timeout-sec = <32>;
	status = "okay";
};

&combophy {
	clocks = <&rcc CK_BUS_USB3PCIEPHY>, <&rcc CK_KER_USB3PCIEPHY>;
    clock-names = "apb-clk", "ker-clk";
	st,rx_equalizer = <1>;
	status = "okay";
};

&crc {
	status = "okay";
};

&cs_cpu_debug0 {
	status = "okay";
};

&cs_cpu_debug1 {
	status = "okay";
};

&cs_cti0 {
	status = "okay";
};

&cs_cti1 {
	status = "okay";
};

&cs_cti_cpu0 {
	status = "okay";
};

&cs_cti_cpu1 {
	status = "okay";
};

&cs_etf {
	status = "okay";
};

&cs_etm0 {
	status = "okay";
};

&cs_etm1 {
	status = "okay";
};

&cs_etr {
	status = "okay";
};

&cs_funnel {
	status = "okay";
};

&cs_replicator {
	status = "okay";
};

&cs_stm {
	status = "okay";
};

&cs_tpiu {
	status = "okay";
};

&csi {
	status = "disabled";
};

&dcmipp {
	status = "disabled";
};

&dsi {
	status = "disabled";
};


&eth1 {
	status = "okay";
	pinctrl-0 = <&eth1_rgmii_pins_b>;
	pinctrl-1 = <&eth1_rgmii_sleep_pins_b>;
	pinctrl-names = "default", "sleep";
	phy-mode = "rgmii-id";
	max-speed = <1000>;
	phy-handle = <&phy1_eth1>;

	/*
	 * Take the RGMII 125 MHz from the RCC PLL, not from the PHY's CLK_OUT
	 * on ETH_CLK125 (PH9). The DP83867 powers up with IO_MUX_CFG (MMD 0x1F,
	 * 0x0170) = 0x0c0e, i.e. CLK_O_SEL = REF_CLK, which drives 25 MHz --
	 * measured on two boards. Without this the MAC clocked GTX_CLK at
	 * 25 MHz on a 1Gbps link and the PHY transmitted nothing valid.
	 * The STM32MP257F-DK needs no such property because its Realtek
	 * RTL8211F does drive a free-running 125 MHz.
	 */
	st,eth-clk-sel;
	snps,ext-systime;

	mdio1 {
		#address-cells = <1>;
		#size-cells = <0>;
		compatible = "snps,dwmac-mdio";

		reset-gpios = <&gpioi 4 GPIO_ACTIVE_LOW>;	/* ETH1_PHY_RST (PI4) */
		reset-delay-us = <10000>;
		reset-post-delay-us = <80000>;

		phy1_eth1: ethernet-phy@0 {
			compatible = "ethernet-phy-id2000.a231", "ethernet-phy-ieee802.3-c22";
			reg = <0>;
			phy-mode = "rgmii-id";
			ti,rx-internal-delay = <DP83867_RGMIIDCTL_2_00_NS>;
			ti,tx-internal-delay = <DP83867_RGMIIDCTL_2_00_NS>;
			ti,fifo-depth = <DP83867_PHYCR_FIFO_DEPTH_4_B_NIB>;
		};
	};
};

&gpu {
	contiguous-area = <&gpu_reserved>;
	status = "okay";
};

&hpdma {
	memory-region = <&hpdma1_lli>;
};

&hpdma2 {
	memory-region = <&hpdma2_lli>;
};

&hpdma3 {
	memory-region = <&hpdma3_lli>;
};

&i2c2 {
	i2c-scl-rising-time-ns = <100>;
	i2c-scl-falling-time-ns = <13>;
	clock-frequency = <100000>;
	status = "okay";
	/* spare dmas for other usage */
	/delete-property/dmas;
	/delete-property/dma-names;
};

&i2c3 {
	i2c-scl-rising-time-ns = <185>;
	i2c-scl-falling-time-ns = <20>;
	clock-frequency = <100000>;
	status = "okay";
	/* spare dmas for other usage */
	/delete-property/dmas;
	/delete-property/dma-names;

	eeprom@50 {
		compatible = "atmel,24c64";
		reg = <0x50>;
		status = "okay";
	};
};

&i2c8 {
	i2c-scl-rising-time-ns = <185>;
	i2c-scl-falling-time-ns = <20>;
	clock-frequency = <100000>;
	status = "okay";
};

&i2s2 {
	status = "disabled";
};

&i2s3 {
	status = "disabled";
};

&ipcc1 {
	status = "okay";
};

&ipcc2 {
	status = "okay";
};

/* use LPTIMER with tick broadcast for suspend mode */
&lptimer3 {
	status = "okay";
	timer {
		status = "okay";
	};
};

&lpuart1 {
	status = "disabled";
};

&m0_rproc {
	mboxes = <&ipcc2 0>, <&ipcc2 1>, <&ipcc2 2>;
	mbox-names = "rx", "tx", "shutdown";
	memory-region = <&cm0_cube_fw>, <&cm0_cube_data>;
	clocks = <&rcc CK_CPU3>,
		 <&rcc CK_CPU3_AM>,
		 <&scmi_clk CK_SCMI_IPCC2>,
		 <&scmi_clk CK_SCMI_IPCC2_AM>;
	status = "okay";
};

/*
 * Load the M33 through OP-TEE, exactly as the STM32MP257F-DK does.
 *
 * The previous non-TEE configuration had Linux load the ELF itself and write
 * the M33 boot vector via st,syscfg-nsvtor. With OP-TEE running, A35SS_SYSCFG
 * is secure, so that write fails and the boot aborts:
 *   remoteproc0: failed to set boot_vec
 *   remoteproc0: can't start rproc m33: -5
 *
 * Under "st,stm32mp2-m33-tee", OP-TEE owns firmware load, authentication and
 * the boot vector, so neither st,syscfg-nsvtor nor the cm33_cube_fw /
 * cm33_cube_data regions belong here -- OP-TEE owns that memory. Only the
 * rpmsg transport regions remain. This makes remoteproc0/fw_format report TEE
 * rather than ELF, and the firmware must be signed with the key whose public
 * half is compiled into OP-TEE (scripts/sign_rproc_fw.py + keys/default.pem).
 */
&m33_rproc {
	compatible = "st,stm32mp2-m33-tee";
	mboxes = <&ipcc1 0x100>, <&ipcc1 0x101>, <&ipcc1 2>;
	mbox-names = "vq0", "vq1", "shutdown";
	memory-region = <&ipc_shmem_1>, <&vdev0vring0>,
			<&vdev0vring1>, <&vdev0buffer>,
			<&cm33_sram2>;
	status = "okay";
};



&mlahb {
	intc_rpmsg: interrupt-controller@1 {
		compatible = "rpmsg,intc";
		reg = <1 0>;
		#interrupt-cells = <1>;
		interrupt-controller;
	};

	i2c_rpmsg: i2c@2 {
		compatible = "rpmsg,i2c-controller";
		reg = <2 0>;
		rpmsg,dev-id = "rpmsg_i2c";
		#address-cells = <1>;
		#size-cells = <0>;
		status = "okay";

		typec@35 {
			compatible = "st,stm32mp25-typec";
			reg = <0x35>;
			interrupts-extended = <&intc_rpmsg 0>;
			status = "okay";
			connector {
				compatible = "usb-c-connector";
				label = "USB-C";

				port {
					typec_ep: endpoint {
						remote-endpoint = <&dwc3_ep>;
					};
				};
			};
		};
	};
};

/*
 * ---------------------------------------------------------------------------
 * WiFi / Bluetooth (Murata / Broadcom), wired like the STM32MP257F-DK — same
 * module and pins on the Savers board:
 *   WiFi   : SDMMC3 SDIO, WL_REG_ON = PG8 (wifi_pwrseq)
 *   BT     : USART1, BT_REG_ON = PG4 (shutdown-gpios)
 *   32 kHz : RTC LSCO on RTC_OUT2 (PI8) feeds the module's LPO
 * NOTE: the brcmfmac / Murata firmware blobs must be installed in the rootfs
 * (image recipe) for WiFi/BT to actually come up.
 * ---------------------------------------------------------------------------
 */
/ {
	wifi_pwrseq: wifi-pwrseq {
		compatible = "mmc-pwrseq-simple";
		reset-gpios = <&gpiog 8 GPIO_ACTIVE_LOW>;	/* WL_REG_ON (PG8) */
		clocks = <&rtc>;
		clock-names = "ext_clock";
	};
};

&rtc {
	#clock-cells = <0>;
	st,lsco = <RTC_OUT2_RMP>;			/* 32 kHz LPO out on RTC_OUT2 (PI8) */
	pinctrl-0 = <&rtc_out2_rmp_pins_a>;
	pinctrl-names = "default";
	status = "okay";
};

&scmi_regu {
	scmi_vddio1: regulator@0 {
		regulator-min-microvolt = <3300000>;
		regulator-max-microvolt = <3300000>;
	};
	scmi_vddcore: regulator@11  {
		reg = <VOLTD_SCMI_STPMIC2_BUCK2>;
		regulator-name = "vddcore";
	};
	scmi_v1v8: regulator@14  {
		reg = <VOLTD_SCMI_STPMIC2_BUCK5>;
		regulator-name = "v1v8";
	};
	scmi_v3v3: regulator@16 {
		reg = <VOLTD_SCMI_STPMIC2_BUCK7>;
		regulator-name = "v3v3";
	};
	scmi_vdd_emmc: regulator@18 {
		reg = <VOLTD_SCMI_STPMIC2_LDO2>;
		regulator-name = "vdd_emmc";
	};
	scmi_vdd3v3_usb: regulator@20 {
		reg = <VOLTD_SCMI_STPMIC2_LDO4>;
		regulator-name = "vdd3v3_usb";
	};
	scmi_vdd_sdcard: regulator@23 {
		reg = <VOLTD_SCMI_STPMIC2_LDO7>;
		regulator-name = "vdd_sdcard";
	};
};

&sdmmc1 {
	pinctrl-names = "default", "opendrain", "sleep";
	pinctrl-0 = <&sdmmc1_b4_pins_b>;
	pinctrl-1 = <&sdmmc1_b4_od_pins_b>;
	pinctrl-2 = <&sdmmc1_b4_sleep_pins_a>;
	cd-gpios = <&gpiod 3 (GPIO_ACTIVE_LOW | GPIO_PULL_UP)>;
	max-frequency = <50000000>;
	disable-wp;
	st,neg-edge;
	bus-width = <4>;
	vmmc-supply = <&scmi_vdd_sdcard>;
	vqmmc-supply = <&scmi_vddio1>;
	status = "okay";
};

&sdmmc2 {
	pinctrl-names = "default", "opendrain", "sleep";
	pinctrl-0 = <&sdmmc2_b4_pins_a &sdmmc2_d47_pins_a>;
	pinctrl-1 = <&sdmmc2_b4_od_pins_a &sdmmc2_d47_pins_a>;
	pinctrl-2 = <&sdmmc2_b4_sleep_pins_a &sdmmc2_d47_sleep_pins_a>;
	non-removable;
	no-sd;
	no-sdio;
	st,neg-edge;
	bus-width = <8>;
	vmmc-supply = <&scmi_vdd_emmc>;
	vqmmc-supply = <&scmi_vddio2>;
	mmc-ddr-1_8v;
        mmc-hs200-1_8v;
	status = "okay";
};

/* Wifi */
&sdmmc3 {
	pinctrl-names = "default", "opendrain", "sleep";
	pinctrl-0 = <&sdmmc3_b4_pins_a>;
	pinctrl-1 = <&sdmmc3_b4_od_pins_a>;
	pinctrl-2 = <&sdmmc3_b4_sleep_pins_a>;
	non-removable;
	st,neg-edge;
	bus-width = <4>;
	vmmc-supply = <&scmi_v3v3>;
	mmc-pwrseq = <&wifi_pwrseq>;
	cap-power-off-card;
	cap-sdio-irq;
	#address-cells = <1>;
	#size-cells = <0>;
	status = "okay";

	brcmf: bcrmf@1 {
		reg = <1>;
		compatible = "brcm,bcm4329-fmac";
		status = "okay";
	};
};

&spi7 {
	status = "disabled";
};

&spi3 {
	status = "disabled";
};

&spi8 {
	status = "disabled";
};

&usart2 {
	pinctrl-names = "default", "idle", "sleep";
	pinctrl-0 = <&usart2_pins_a>;
	pinctrl-1 = <&usart2_idle_pins_a>;
	pinctrl-2 = <&usart2_sleep_pins_a>;
	/delete-property/dmas;
	/delete-property/dma-names;
	status = "okay";
};

&usart6 {
	uart-has-rtscts;
};

&usart1 {
	/delete-property/dmas;
	/delete-property/dma-names;
	uart-has-rtscts;
	status = "okay";
	bluetooth {
		compatible = "brcm,bcm43438-bt";
		shutdown-gpios = <&gpiog 4 GPIO_ACTIVE_HIGH>;	/* BT_REG_ON (PG4) */
		clocks = <&rtc>;
		clock-names = "lpo";
		max-speed = <2000000>;
		vbat-supply = <&scmi_v3v3>;
		vddio-supply = <&scmi_v3v3>;
	};
};

&uart4 {
	status = "disabled";
};

&uart8 {
	status = "disabled";
};

&uart9 {
	status = "disabled";
};

&usb2_phy1 {
	vdd33-supply = <&scmi_vdd3v3_usb>;
	status = "okay";
};

&usb2_phy2 {
	vdd33-supply = <&scmi_vdd3v3_usb>;
	status = "okay";
};

&usbh {
	status = "okay";

	usbh_ehci: usb@482f0000 {
		#address-cells = <1>;
		#size-cells = <0>;
		/* onboard HUB */
		hub@1 {
			compatible = "usb424,2514";
			reg = <1>;
			vdd-supply = <&scmi_v3v3>;
		};
	};

	usbh_ohci: usb@482e0000 {
		status = "disabled";
	};
};

&usb3dr {
	status = "okay";

	dwc3: usb@48300000 {
		phys            = <&usb2_phy2>, <&combophy PHY_TYPE_USB3>;
		phy-names       = "usb2-phy", "usb3-phy";
        maximum-speed = "super-speed";
        snps,incr-burst-type-adjustment = <4>;
        dr_mode = "otg";
		usb-role-switch;
        role-switch-default-mode = "peripheral";
        //role-switch-default-mode = "host";
        snps,dis_u2_susphy_quirk;
        snps,dis_u3_susphy_quirk;
        snps,dis_enblslpm_quirk;
        snps,dis-tx-ipgap-linecheck-quirk;
		port {
			dwc3_ep: endpoint {
				remote-endpoint = <&typec_ep>;
			};
		};
	};
};

/* THERM: NTC 10k (NCP18XH103J03RB) from 3V3 to PG1, 10k 1% from PG1 to GND. */
&adc_12 {
	pinctrl-names = "default";
	pinctrl-0 = <&adc12_pins_mx>;
	vdda-supply = <&scmi_v1v8>;	/* ADC analog bias rail - NOT the divider supply, see vref-supply */
	vref-supply = <&scmi_v3v3>;	/* ADC reference rail = 3V3 (matches divider supply) */
	status = "okay";
};

&adc1 {
	status = "okay";
	channel@6 {
		reg = <6>;		/* PG1 = ADC1_INP6 (THERM) */
		/* Divider source impedance (~5-20k over temp) is higher than a
		 * directly-driven signal, so use a longer sample time than
		 * ADC3's channel@2 (400ns) to let the S/H cap settle. */
		st,min-sample-time-ns = <10000>;
	};
};

/* THERM (NTC 10k, connected-positive per the schematic's 3V3-NTC-PG1-10k-GND
 * divider) exposed as a hwmon/thermal sensor via the ntc-thermistor driver.
 * "murata,ncp15xh103" is the closest bound compatible: the driver keys its
 * R-T curve on the "XH103" suffix (10k/B-constant), not the "15" vs "18"
 * package-size digit (see TYPE_NCPXXXH103 in ntc_thermistor.c), so it's the
 * correct curve for our NCP18XH103J03RB part.
 */
/ {
	thermistor: thermistor {
		compatible = "murata,ncp15xh103";
		io-channels = <&adc1 6>;
		pullup-uv = <3300000>;
		pullup-ohm = <0>;
		pulldown-ohm = <10000>;
		connected-positive;
		#thermal-sensor-cells = <0>;
	};

	/*
	 * PWM_FAN (PG9/TIM5_CH4) drives a 4-wire 24V fan (QFR0824HHP0) through
	 * an open-drain optocoupler (FODM121, schematic sheet 21 "PWM FAN").
	 * Unlike LED_ILL, there's no documented inversion here — an
	 * optocoupler sinking the line low for X% of the period is the
	 * standard 4-wire-fan PWM convention, so normal polarity is correct.
	 * TACH isn't wired to any MCU pin on this board revision, so RPM
	 * feedback isn't available — this is open-loop speed control only.
	 */
	fan0: pwm-fan {
		compatible = "pwm-fan";
		pwms = <&pwm5 3 40000 0>;	/* 25kHz, per the 4-wire fan PWM spec */
		#cooling-cells = <2>;
		/* Duty-cycle steps (0-255) for cooling states 0..3 below. */
		cooling-levels = <0 85 170 255>;
	};

	/*
	 * Starting-point trip curve for THERM-driven fan ramp — not a
	 * calibrated thermal design. Tune temperature/hysteresis once the
	 * enclosure's real thermal behavior is characterized.
	 */
	thermal-zones {
		board-thermal {
			polling-delay-passive = <1000>;
			polling-delay = <5000>;
			thermal-sensors = <&thermistor>;

			trips {
				board_fan_low: board-fan-low {
					temperature = <45000>;
					hysteresis = <3000>;
					type = "active";
				};
				board_fan_mid: board-fan-mid {
					temperature = <55000>;
					hysteresis = <3000>;
					type = "active";
				};
				board_fan_high: board-fan-high {
					temperature = <65000>;
					hysteresis = <3000>;
					type = "active";
				};
			};

			cooling-maps {
				map0 {
					trip = <&board_fan_low>;
					cooling-device = <&fan0 1 1>;
				};
				map1 {
					trip = <&board_fan_mid>;
					cooling-device = <&fan0 2 2>;
				};
				map2 {
					trip = <&board_fan_high>;
					cooling-device = <&fan0 3 3>;
				};
			};
		};
	};
};
