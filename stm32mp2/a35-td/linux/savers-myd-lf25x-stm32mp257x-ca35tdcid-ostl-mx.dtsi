#include <dt-bindings/pwm/pwm.h>

&pinctrl {
	i2c1_pins_mx: i2c1_mx-0 {
		pins {
			pinmux = <STM32_PINMUX('G', 13, AF9)>, /* I2C1_SCL */
				 <STM32_PINMUX('I', 1, AF9)>; /* I2C1_SDA */
			bias-disable;
			drive-open-drain;
			slew-rate = <0>;
		};
	};
	i2c1_sleep_pins_mx: i2c1_sleep_mx-0 {
		pins {
			pinmux = <STM32_PINMUX('G', 13, ANALOG)>, /* I2C1_SCL */
				 <STM32_PINMUX('I', 1, ANALOG)>; /* I2C1_SDA */
		};
	};

	i2c2_pins_mx: i2c2_mx-0 {
		pins {
			pinmux = <STM32_PINMUX('F', 0, AF9)>, /* I2C2_SDA */
				 <STM32_PINMUX('F', 2, AF9)>; /* I2C2_SCL */
			bias-disable;
			drive-open-drain;
			slew-rate = <0>;
		};
	};
	i2c2_sleep_pins_mx: i2c2_sleep_mx-0 {
		pins {
			pinmux = <STM32_PINMUX('F', 0, ANALOG)>, /* I2C2_SDA */
				 <STM32_PINMUX('F', 2, ANALOG)>; /* I2C2_SCL */
		};
	};

	i2c3_pins_mx: i2c3_mx-0 {
		pins {
			pinmux = <STM32_PINMUX('C', 12, AF9)>, /* I2C3_SCL */
				 <STM32_PINMUX('G', 0, AF9)>; /* I2C3_SDA */
			bias-disable;
			drive-open-drain;
			slew-rate = <0>;
		};
	};
	i2c3_sleep_pins_mx: i2c3_sleep_mx-0 {
		pins {
			pinmux = <STM32_PINMUX('C', 12, ANALOG)>, /* I2C3_SCL */
				 <STM32_PINMUX('G', 0, ANALOG)>; /* I2C3_SDA */
		};
	};

	spi2_pins_mx: spi2_mx-0 {
		pins {
			pinmux = <STM32_PINMUX('B', 0, AF2)>, /* SPI2_SCK */
				 <STM32_PINMUX('B', 2, AF2)>; /* SPI2_MOSI */
			bias-disable;
			drive-push-pull;
			slew-rate = <0>;
		};
	};
	spi2_sleep_pins_mx: spi2_sleep_mx-0 {
		pins {
			pinmux = <STM32_PINMUX('B', 0, ANALOG)>, /* SPI2_SCK */
				 <STM32_PINMUX('B', 2, ANALOG)>; /* SPI2_MOSI */
		};
	};

	spi3_pins_mx: spi3_mx-0 {
		pins {
			pinmux = <STM32_PINMUX('B', 7, AF1)>, /* SPI3_SCK */
				 <STM32_PINMUX('B', 8, AF1)>, /* SPI3_MOSI */
				 <STM32_PINMUX('B', 10, AF1)>; /* SPI3_MISO */
			bias-disable;
			drive-push-pull;
			slew-rate = <0>;
		};
	};
	spi3_sleep_pins_mx: spi3_sleep_mx-0 {
		pins {
			pinmux = <STM32_PINMUX('B', 7, ANALOG)>, /* SPI3_SCK */
				 <STM32_PINMUX('B', 8, ANALOG)>, /* SPI3_MOSI */
				 <STM32_PINMUX('B', 10, ANALOG)>; /* SPI3_MISO */
		};
	};

	spi5_pins_mx: spi5_mx-0 {
		pins {
			pinmux = <STM32_PINMUX('F', 12, AF2)>, /* SPI5_MISO */
				 <STM32_PINMUX('G', 6, AF2)>, /* SPI5_SCK */
				 <STM32_PINMUX('I', 5, AF2)>; /* SPI5_MOSI */
			bias-disable;
			drive-push-pull;
			slew-rate = <0>;
		};
	};
	spi5_sleep_pins_mx: spi5_sleep_mx-0 {
		pins {
			pinmux = <STM32_PINMUX('F', 12, ANALOG)>, /* SPI5_MISO */
				 <STM32_PINMUX('G', 6, ANALOG)>, /* SPI5_SCK */
				 <STM32_PINMUX('I', 5, ANALOG)>; /* SPI5_MOSI */
		};
	};

	tim2_pins_mx: tim2_mx-0 {
		pins {
			pinmux = <STM32_PINMUX('H', 5, AF7)>, /* TIM2_CH1 (ENC_A) */
				 <STM32_PINMUX('F', 15, AF7)>, /* TIM2_CH2 (ENC_B) */
				 <STM32_PINMUX('F', 7, AF7)>; /* TIM2_ETR (ENC_N) */
			bias-disable;
		};
	};
	tim2_sleep_pins_mx: tim2_sleep_mx-0 {
		pins {
			pinmux = <STM32_PINMUX('H', 5, ANALOG)>, /* TIM2_CH1 (ENC_A) */
				 <STM32_PINMUX('F', 15, ANALOG)>, /* TIM2_CH2 (ENC_B) */
				 <STM32_PINMUX('F', 7, ANALOG)>; /* TIM2_ETR (ENC_N) */
		};
	};

	tim4_pins_mx: tim4_mx-0 {
		pins {
			pinmux = <STM32_PINMUX('D', 6, AF9)>; /* TIM4_CH3 */
			bias-disable;
			drive-push-pull;
			slew-rate = <0>;
		};
	};
	tim4_sleep_pins_mx: tim4_sleep_mx-0 {
		pins {
			pinmux = <STM32_PINMUX('D', 6, ANALOG)>; /* TIM4_CH3 */
		};
	};
	tim4_pwm_pins_mx: tim4_pwm_mx-0 {
		pins {
			pinmux = <STM32_PINMUX('D', 5, AF9)>, /* TIM4_CH2 (EXP_HEADER) */
				 <STM32_PINMUX('D', 7, AF9)>; /* TIM4_CH4 (LED_ILL) */
			bias-disable;
			drive-push-pull;
			slew-rate = <0>;
		};
	};
	tim4_pwm_sleep_pins_mx: tim4_pwm_sleep_mx-0 {
		pins {
			pinmux = <STM32_PINMUX('D', 5, ANALOG)>, /* TIM4_CH2 (EXP_HEADER) */
				 <STM32_PINMUX('D', 7, ANALOG)>; /* TIM4_CH4 (LED_ILL) */
		};
	};

	tim5_pwm_pins_mx: tim5_pwm_mx-0 {
		pins {
			pinmux = <STM32_PINMUX('G', 9, AF8)>; /* TIM5_CH4 (PWM_FAN) */
			bias-disable;
			drive-push-pull;
			slew-rate = <0>;
		};
	};
	tim5_pwm_sleep_pins_mx: tim5_pwm_sleep_mx-0 {
		pins {
			pinmux = <STM32_PINMUX('G', 9, ANALOG)>; /* TIM5_CH4 (PWM_FAN) */
		};
	};

	tim20_pwm_pins_mx: tim20_pwm_mx-0 {
		pins {
			pinmux = <STM32_PINMUX('B', 6, AF8)>; /* TIM20_CH1N */
			bias-disable;
			drive-push-pull;
			slew-rate = <0>;
		};
	};
	tim20_pwm_sleep_pins_mx: tim20_pwm_sleep_mx-0 {
		pins {
			pinmux = <STM32_PINMUX('B', 6, ANALOG)>; /* TIM20_CH1N */
		};
	};

	usart1_pins_mx: usart1_mx-0 {
		pins1 {
			pinmux = <STM32_PINMUX('G', 14, AF6)>, /* USART1_TX */
				 <STM32_PINMUX('I', 2, AF6)>; /* USART1_RTS */
			bias-disable;
			drive-push-pull;
			slew-rate = <0>;
		};
		pins2 {
			pinmux = <STM32_PINMUX('G', 15, AF6)>, /* USART1_RX */
				 <STM32_PINMUX('I', 3, AF6)>; /* USART1_CTS */
			bias-disable;
			drive-push-pull;
		};
	};
	usart1_idle_pins_mx: usart1_idle_mx-0 {
		pins1 {
			pinmux = <STM32_PINMUX('G', 14, ANALOG)>, /* USART1_TX */
				 <STM32_PINMUX('I', 3, ANALOG)>; /* USART1_CTS */
		};
		pins2 {
			pinmux = <STM32_PINMUX('G', 15, AF6)>; /* USART1_RX */
			bias-disable;
			drive-push-pull;
		};
		pins3 {
			pinmux = <STM32_PINMUX('I', 2, AF6)>; /* USART1_RTS */
			bias-disable;
			drive-push-pull;
			slew-rate = <0>;
		};
	};
	usart1_sleep_pins_mx: usart1_sleep_mx-0 {
		pins {
			pinmux = <STM32_PINMUX('G', 14, ANALOG)>, /* USART1_TX */
				 <STM32_PINMUX('G', 15, ANALOG)>, /* USART1_RX */
				 <STM32_PINMUX('I', 2, ANALOG)>, /* USART1_RTS */
				 <STM32_PINMUX('I', 3, ANALOG)>; /* USART1_CTS */
		};
	};

	usart3_pins_mx: usart3_mx-0 {
		pins1 {
			pinmux = <STM32_PINMUX('F', 13, AF6)>, /* USART3_CTS */
				 <STM32_PINMUX('I', 7, AF6)>; /* USART3_RX */
			bias-disable;
			drive-push-pull;
		};
		pins2 {
			pinmux = <STM32_PINMUX('F', 14, AF6)>, /* USART3_RTS */
				 <STM32_PINMUX('I', 6, AF6)>; /* USART3_TX */
			bias-disable;
			drive-push-pull;
			slew-rate = <0>;
		};
	};
	usart3_idle_pins_mx: usart3_idle_mx-0 {
		pins1 {
			pinmux = <STM32_PINMUX('F', 13, ANALOG)>, /* USART3_CTS */
				 <STM32_PINMUX('I', 6, ANALOG)>; /* USART3_TX */
		};
		pins2 {
			pinmux = <STM32_PINMUX('F', 14, AF6)>; /* USART3_RTS */
			bias-disable;
			drive-push-pull;
			slew-rate = <0>;
		};
		pins3 {
			pinmux = <STM32_PINMUX('I', 7, AF6)>; /* USART3_RX */
			bias-disable;
			drive-push-pull;
		};
	};
	usart3_sleep_pins_mx: usart3_sleep_mx-0 {
		pins {
			pinmux = <STM32_PINMUX('F', 13, ANALOG)>, /* USART3_CTS */
				 <STM32_PINMUX('F', 14, ANALOG)>, /* USART3_RTS */
				 <STM32_PINMUX('I', 6, ANALOG)>, /* USART3_TX */
				 <STM32_PINMUX('I', 7, ANALOG)>; /* USART3_RX */
		};
	};

	usart6_pins_mx: usart6_mx-0 {
		pins1 {
			pinmux = <STM32_PINMUX('C', 3, AF6)>, /* USART6_RTS */
				 <STM32_PINMUX('F', 5, AF6)>; /* USART6_TX */
			bias-disable;
			drive-push-pull;
			slew-rate = <0>;
		};
		pins2 {
			pinmux = <STM32_PINMUX('C', 8, AF6)>, /* USART6_CTS */
				 <STM32_PINMUX('F', 4, AF6)>; /* USART6_RX */
			bias-disable;
			drive-push-pull;
		};
	};
	usart6_idle_pins_mx: usart6_idle_mx-0 {
		pins1 {
			pinmux = <STM32_PINMUX('C', 3, AF6)>; /* USART6_RTS */
			bias-disable;
			drive-push-pull;
			slew-rate = <0>;
		};
		pins2 {
			pinmux = <STM32_PINMUX('C', 8, ANALOG)>, /* USART6_CTS */
				 <STM32_PINMUX('F', 5, ANALOG)>; /* USART6_TX */
		};
		pins3 {
			pinmux = <STM32_PINMUX('F', 4, AF6)>; /* USART6_RX */
			bias-disable;
			drive-push-pull;
		};
	};
	usart6_sleep_pins_mx: usart6_sleep_mx-0 {
		pins {
			pinmux = <STM32_PINMUX('C', 3, ANALOG)>, /* USART6_RTS */
				 <STM32_PINMUX('C', 8, ANALOG)>, /* USART6_CTS */
				 <STM32_PINMUX('F', 4, ANALOG)>, /* USART6_RX */
				 <STM32_PINMUX('F', 5, ANALOG)>; /* USART6_TX */
		};
	};

	adc12_pins_mx: adc12_mx-0 {
		pins {
			pinmux = <STM32_PINMUX('G', 1, ANALOG)>; /* ADC1_INP6 (THERM) */
		};
	};

	/* --- Peripherals CubeMX assigned to the M33, exposed in Linux on request --- */

	spi1_pins_mx: spi1_mx-0 {
		pins {
			pinmux = <STM32_PINMUX('D', 11, AF2)>, /* SPI1_SCK */
				 <STM32_PINMUX('D', 9, AF2)>, /* SPI1_MOSI */
				 <STM32_PINMUX('D', 1, AF2)>; /* SPI1_MISO */
			bias-disable;
			drive-push-pull;
			slew-rate = <0>;
		};
	};
	spi1_sleep_pins_mx: spi1_sleep_mx-0 {
		pins {
			pinmux = <STM32_PINMUX('D', 11, ANALOG)>, /* SPI1_SCK */
				 <STM32_PINMUX('D', 9, ANALOG)>, /* SPI1_MOSI */
				 <STM32_PINMUX('D', 1, ANALOG)>; /* SPI1_MISO */
		};
	};

	adc3_pins_mx: adc3_mx-0 {
		pins {
			pinmux = <STM32_PINMUX('F', 10, ANALOG)>; /* ADC3_INP2 */
		};
	};
};

&pinctrl_z {
	i2c8_pins_z_mx: i2c8_mx-0 {
		pins {
			pinmux = <STM32_PINMUX('Z', 3, AF8)>, /* I2C8_SDA */
				 <STM32_PINMUX('Z', 4, AF8)>; /* I2C8_SCL */
			bias-disable;
			drive-open-drain;
			slew-rate = <0>;
		};
	};
	i2c8_sleep_pins_z_mx: i2c8_sleep_mx-0 {
		pins {
			pinmux = <STM32_PINMUX('Z', 3, ANALOG)>, /* I2C8_SDA */
				 <STM32_PINMUX('Z', 4, ANALOG)>; /* I2C8_SCL */
		};
	};
};

/* ------------------------- Controller enables ------------------------- */

&i2c1 {
	pinctrl-names = "default", "sleep";
	pinctrl-0 = <&i2c1_pins_mx>;
	pinctrl-1 = <&i2c1_sleep_pins_mx>;
	status = "okay";
};

&i2c2 {
	pinctrl-names = "default", "sleep";
	pinctrl-0 = <&i2c2_pins_mx>;
	pinctrl-1 = <&i2c2_sleep_pins_mx>;
	status = "okay";
};

&i2c3 {
	pinctrl-names = "default", "sleep";
	pinctrl-0 = <&i2c3_pins_mx>;
	pinctrl-1 = <&i2c3_sleep_pins_mx>;
	status = "okay";
};

&i2c8 {
	pinctrl-names = "default", "sleep";
	pinctrl-0 = <&i2c8_pins_z_mx>;
	pinctrl-1 = <&i2c8_sleep_pins_z_mx>;
	status = "okay";
};

&usart1 {
	pinctrl-names = "default", "idle", "sleep";
	pinctrl-0 = <&usart1_pins_mx>;
	pinctrl-1 = <&usart1_idle_pins_mx>;
	pinctrl-2 = <&usart1_sleep_pins_mx>;
	status = "okay";
};

&usart3 {
	pinctrl-names = "default", "idle", "sleep";
	pinctrl-0 = <&usart3_pins_mx>;
	pinctrl-1 = <&usart3_idle_pins_mx>;
	pinctrl-2 = <&usart3_sleep_pins_mx>;
	status = "okay";
};

&usart6 {
	pinctrl-names = "default", "idle", "sleep";
	pinctrl-0 = <&usart6_pins_mx>;
	pinctrl-1 = <&usart6_idle_pins_mx>;
	pinctrl-2 = <&usart6_sleep_pins_mx>;
	status = "okay";
};

/*
 * SPI controllers are enabled with their CubeMX pinmux. Chip-selects are kept
 * as GPIOs (see gpio-line-names: DISPLAY_CS, EXPAN_CS). Add cs-gpios and the
 * SPI child device nodes when the actual devices are wired up.
 */
&spi2 {
	pinctrl-names = "default", "sleep";
	pinctrl-0 = <&spi2_pins_mx>;
	pinctrl-1 = <&spi2_sleep_pins_mx>;
	status = "okay";
};

&spi3 {
	pinctrl-names = "default", "sleep";
	pinctrl-0 = <&spi3_pins_mx>;
	pinctrl-1 = <&spi3_sleep_pins_mx>;
	status = "okay";
};

&spi5 {
	pinctrl-names = "default", "sleep";
	pinctrl-0 = <&spi5_pins_mx>;
	pinctrl-1 = <&spi5_sleep_pins_mx>;
	status = "okay";
};

/*
 * PWM outputs (RGB / illumination LEDs on TIM4, fan on TIM5_CH4, TIM20_CH1N).
 * Per the st,stm32mp25-timers binding, pinctrl lives on the `pwm` child node,
 * not the parent timer.
 */
&timers4 {
	status = "okay";
	pwm4: pwm {
		pinctrl-names = "default", "sleep";
		pinctrl-0 = <&tim4_pwm_pins_mx>, <&tim4_pins_mx>;
		pinctrl-1 = <&tim4_pwm_sleep_pins_mx>, <&tim4_sleep_pins_mx>;
		status = "okay";
	};
};

/*
 * LED_ILL (TIM4_CH4/PD7) drives an opto-isolator + MOSFET stage that is
 * hardware-inverted (schematic sheet 17 "RGB Outputs": PWM high => LED off,
 * PWM low => LED on, "*INVERTED PWM TO POWER"). PWM_POLARITY_INVERTED here
 * makes the LED class's brightness 0 = off / max = full, so callers don't
 * need to invert duty-cycle math themselves.
 */
/ {
	pwm-leds {
		compatible = "pwm-leds";

		led-0 {
			label = "led_ill";
			pwms = <&pwm4 3 100000 PWM_POLARITY_INVERTED>;
			max-brightness = <255>;
		};
	};
};

&timers5 {
	status = "okay";
	pwm5: pwm {
		pinctrl-names = "default", "sleep";
		pinctrl-0 = <&tim5_pwm_pins_mx>;
		pinctrl-1 = <&tim5_pwm_sleep_pins_mx>;
		status = "okay";
	};
};

&timers20 {
	status = "okay";
	pwm {
		pinctrl-names = "default", "sleep";
		pinctrl-0 = <&tim20_pwm_pins_mx>;
		pinctrl-1 = <&tim20_pwm_sleep_pins_mx>;
		status = "okay";
	};
};

/* --- Peripherals CubeMX assigned to the M33, exposed in Linux on request --- */

&spi1 {
	pinctrl-names = "default", "sleep";
	pinctrl-0 = <&spi1_pins_mx>;
	pinctrl-1 = <&spi1_sleep_pins_mx>;
	cs-gpios = <&gpiod 0 GPIO_ACTIVE_LOW>;	/* STM_AX_SPI1_CS (PD0) */
	status = "okay";

	tmc9660@0 {
		compatible = "rohm,dh2228fv"; /* generic spidev binding */
		reg = <0>;
		/* TMC9660 SPI tops out at 16 MHz; 4 MHz is a safe bring-up rate. */
		spi-max-frequency = <4000000>;
		/* TMC9660 SPI is mode 3 (CPOL=1, CPHA=1). */
		spi-cpol;
		spi-cpha;
	};
};

&adc_3 {
	pinctrl-names = "default";
	pinctrl-0 = <&adc3_pins_mx>;
	vdda-supply = <&scmi_v3v3>;
	vref-supply = <&scmi_v3v3>;	/* ADC reference rail = 3V3 */
	status = "okay";
};

&adc3 {
	status = "okay";
	channel@2 {
		reg = <2>;		/* PF10 = ADC3_INP2 */
		st,min-sample-time-ns = <400>;
	};
};

&timers2 {
	status = "okay";

	counter {
		pinctrl-names = "default", "sleep";
		pinctrl-0 = <&tim2_pins_mx>;
		pinctrl-1 = <&tim2_sleep_pins_mx>;
		status = "okay";
	};
};

/* ----------------- GPIO line names (from CubeMX labels) ----------------- */

&gpioa {
	gpio-line-names =
		"", "STM_AX_FLT1", "STM_AX_RST2", "STM_AX_WAKE0",		/* PA0-PA3 */
		"", "STM_AX_RST0", "STM_AX_RST1", "STM_AX_FLT0";		/* PA4-PA7 */
};

&gpiob {
	gpio-line-names =
		"", "MOM0", "", "DISPLAY_CS",		/* PB0-PB3 */
		"PNP3", "PNP6", "", "",				/* PB4-PB7 */
		"", "STM_AX_EN0", "", "EXPAN_CS";	/* PB8-PB11 */
};

&gpioc {
	gpio-line-names =
		"", "", "", "",												/* PC0-PC3 */
		"SOLENOID2", "BUTTON_USER1", "STM_AX_FLT2", "EEPROM_WC",	/* PC4-PC7 */
		"", "SOLENOID0", "USB3_EN";									/* PC8-PC10 */
};

&gpiod {
	gpio-line-names =
		"STM_AX_SPI1_CS", "", "STM_AX_EN2", "uSD_DETECT",	/* PD0-PD3 */
		"DISPLAY_DC", "", "EXPAN_GPIO_0", "",				/* PD4-PD7 */
		"RES_N", "", "STM_AX_EN1";							/* PD8-PD10 */
};

&gpiof {
	gpio-line-names =
		"", "", "", "",							/* PF0-PF3 */
		"", "", "STM_AX_WAKE2", "",				/* PF4-PF7 (PF7 = ENC_N, TIM2_ETR) */
		"ADC_ALERT", "SOLENOID1", "", "MOM3",	/* PF8-PF11 */
		"", "", "", "";							/* PF12-PF15 (PF15 = ENC_B, TIM2_CH2) */
};

&gpiog {
	gpio-line-names =
		"", "", "BT_HOST_WAKE", "PNP7",					/* PG0-PG3 */
		"BT_REG_ON", "EXPAN_GPIO_1", "", "BT_PCM_WS",	/* PG4-PG7 */
		"WL_REG_ON", "", "MOM1", "WL_HOST_WAKE",		/* PG8-PG11 */
		"MOM2";											/* PG12 */
};

&gpioh {
	gpio-line-names =
		"", "", "USBSW_OE", "USB3SW_S",		/* PH0-PH3 */
		"LED1", "", "", "",					/* PH4-PH7 (PH5 = ENC_A, TIM2_CH1) */
		"STM_AX_WAKE1";						/* PH8 */
};

&gpioi {
	gpio-line-names =
		"PNP4", "", "", "",				/* PI0-PI3 */
		"ETH1_PHY_RST", "", "", "",		/* PI4-PI7 */
		"", "PNP1", "PNP0";				/* PI8-PI10 */
};

&gpioz {
	gpio-line-names =
		"PNP2", "EXPAN_GPIO_2", "PNP8", "",	/* PZ0-PZ3 */
		"", "PNP5", "", "",					/* PZ4-PZ7 */
		"", "PNP9";							/* PZ8-PZ9 */
};
