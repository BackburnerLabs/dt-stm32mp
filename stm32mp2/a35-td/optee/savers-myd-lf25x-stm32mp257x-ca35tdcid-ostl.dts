 * Copyright (C) Savers 2024 - All Rights Reserved
 *
 * Savers MYD-LF25X (OP-TEE / CA35TDCID OSTL).
 *
 * Re-based onto MYiR's vanilla myb-stm32mp257x-1GB device tree. The SoM-level
 * secure configuration (STPMIC2, SCMI regulators, RIF/RISAF firewall, M33
 * remoteproc, RCC, TAMP, OTP shadow) all comes from MYiR's known-good base
 * (myb-stm32mp257x-base.dtsi + -rcc.dtsi + -rif.dtsi) instead of a
 * STM32MP257F-DK copy.
 *
 * SoM: MYiR MYD-LF25X, STM32MP257F (AI package), 1GB LPDDR4 (1x8Gbits).
 */

/dts-v1/;

#include "myb-stm32mp257x-base.dtsi"
#include "myb-stm32mp257x-rcc.dtsi"
#include "myb-stm32mp257x-1GB-resmem.dtsi"
#include "myb-stm32mp257x-rif.dtsi"
#include "stm32mp25-pinctrl.dtsi"
#include "stm32mp25xxai-pinctrl.dtsi"

/ {
	model = "Savers MYD-LF25X (STM32MP257) CA35TDCID OSTL";
	compatible = "savers,savers-myd-lf25x", "st,myb-stm32mp257x-1GB",
		     "myir,myb-stm32mp257x-1GB", "myir,myd-lf25x", "st,stm32mp257";

	aliases {
		serial0 = &usart2;
	};

	chosen {
		stdout-path = "serial0:115200n8";
	};

	memory@80000000 {
		device_type = "memory";
		reg = <0x0 0x80000000 0x0 0x40000000>;
	};

};

/*
 * Expose the UCPD supply as an SCMI voltage domain so the Cortex-M33 can turn
 * it on.
 *
 * ST's USBPD_DRP_UCSI firmware does this in MX_UCPD1_Init():
 *
 *   if (ResMgr_Request(RESMGR_RESOURCE_RIF_PWR, RESMGR_PWR_RESOURCE(0)) == OK)
 *       HAL_PWREx_EnableSupply(PWR_PVM_UCPD);
 *   else if (scmi_voltage_domain_enable(&scmi_channel, VOLTD_SCMI_UCPD))
 *       Error_Handler();          <-- spins forever
 *
 * RIF_PWR_RESOURCE(0) is RIF_SEC/RIF_CID1 here and on the DK, so the direct
 * path always fails and the firmware relies on SCMI. Without this domain the
 * SCMI call fails and the firmware hangs inside MX_UCPD1_Init -- before the
 * RTOS starts, so no UCSI task, no "rpmsg_i2c" channel and an empty
 * /sys/class/typec. Confirmed by instrumenting the firmware: a marker after
 * HAL_Init() was reached, the one after MX_UCPD1_Init() never was.
 *
 * The DK gets this from stm32mp25-st-scmi-cfg.dtsi (see its m33-examples
 * variant); the MYIR base this board derives from does not include it. Only
 * the one domain is added rather than that whole file, to avoid disturbing
 * MYIR's existing SCMI configuration. VOLTD_SCMI_UCPD is 5, which does not
 * collide with the STPMIC2 domains MYIR declares (0xb, 0xe, 0x10, 0x12,
 * 0x14, 0x15, 0x16).
 */
&scmi_regulator {
	regulator@5 {
		reg = <VOLTD_SCMI_UCPD>;
		voltd-supply = <&vdd33ucpd>;
	};
};

/*
 * Keep the UCPD 3V3 rail up for the Cortex-M33.
 *
 * myb-stm32mp257x-base.dtsi already sets vdd33ucpd to "okay", but nothing on
 * the A35 side -- neither OP-TEE nor Linux -- consumes it, so an unclaimed
 * regulator can be turned off. The only user is M33 firmware driving UCPD for
 * USB-C CC detection, and it has no way to request the rail.
 *
 * Both M33-capable reference trees add this: MYIR's own
 * myb-stm32mp257x-1GB-ca35tdcid-ostl-m33-examples.dts and ST's
 * stm32mp257f-dk-ca35tdcid-ostl-m33-examples.dts. The plain (non-m33) variants
 * this board was derived from omit it, which is consistent with the symptom --
 * ST's USBPD_DRP_UCSI firmware boots and brings up rpmsg, but never announces
 * its rpmsg_i2c channel, so no UCSI interface is registered and Linux sees no
 * Type-C port.
 */
&vdd33ucpd {
	regulator-always-on;
};

&tamp {
	/delete-node/ tamp-button;
};